# ============================================================
# Palm & Paradise — environment configuration
# Copy this file to `.env` and change ALL values before launch.
# `.env` is git-ignored and never shipped to the browser.
# ============================================================

# --- Admin authentication ------------------------------------
# Credentials for the single admin account (Palm & Paradise staff).
# CHANGE THESE before going live. Stored server-side only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-launch

# Secret used to sign the admin session cookie.
# Generate a long random value, e.g. `openssl rand -hex 32`
SESSION_SECRET=generate-a-long-random-value

# --- Public site content -------------------------------------
# Editable site copy (contact details, tagline, addresses) lives
# in `src/lib/site.ts` — no environment variables required.